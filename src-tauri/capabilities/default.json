{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default TableScribe desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "opener:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/Documents/TableScribe/**" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/whisper-cli",
          "sidecar": true
        },
        {
          "name": "binaries/whisper-stream",
          "sidecar": true
        }
      ]
    }
  ]
}
